# Copy to mobile/.env.local (git-ignored) and fill in.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle and is
# therefore public. Only the Supabase publishable (anon) key belongs here —
# never the service_role key.

# Supabase → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → publishable / anon
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Express API, including the /api prefix.
# A physical phone cannot reach "localhost" on your computer: use the
# computer's LAN IP (e.g. http://192.168.1.20:5000/api). The Android emulator
# reaches the host at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api

# Development only: open every progressive unlock (Mirror on day 3, patterns
# on day 7, …) from the first day. Leave unset in real builds.
# EXPO_PUBLIC_UNLOCK_ALL=1
