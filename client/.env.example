# Copy to client/.env.local

# Base URL of the MirrorSpace API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API Keys -> anon / publishable.
# This one is meant to be public: it ships in the browser bundle. Every table
# denies it outright, so it can do nothing without a session, and Row Level
# Security then narrows a session to its own rows. Never put the service_role
# key here.
VITE_SUPABASE_ANON_KEY=
