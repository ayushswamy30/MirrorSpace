# ---------------------------------------------------------------------------
# MirrorSpace API
# Copy to server/.env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Supabase --------------------------------------------------------------
# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API Keys -> service_role (secret)
# This key bypasses Row Level Security. It belongs on the server only —
# it must never end up in the client bundle or in git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Verifying Supabase sessions -------------------------------------------
# Sessions are issued by Supabase Auth; this API only verifies them.
#
# Projects using JWT signing keys (the current default) need nothing here —
# the public keys are read from the project's JWKS endpoint and verification
# happens locally, with no round trip to the Auth server.
#
# Only set this if the project is still on the legacy shared HMAC secret
# (Project Settings -> JWT Keys -> legacy JWT secret).
SUPABASE_JWT_SECRET=

# How long to wait between JWKS refetches, in milliseconds. This bounds how
# quickly a newly rotated signing key is picked up. Default 30000.
SUPABASE_JWKS_COOLDOWN_MS=30000

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- AI providers (optional) -----------------------------------------------
# With neither set, reflections and insights use built-in fallback text.
GROQ_API_KEY=
OPENAI_API_KEY=
