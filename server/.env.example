# ---------------------------------------------------------------------------
# MirrorSpace API
# Copy to server/.env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Supabase --------------------------------------------------------------
# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API Keys -> service_role (secret)
# This key bypasses Row Level Security. It belongs on the server only —
# it must never end up in the client bundle or in git.
SUPABASE_SERVICE_ROLE_KEY=

# --- App session tokens ----------------------------------------------------
# Signs the anonymous session JWTs the app issues. Unrelated to Supabase's
# own JWT secret. Generate one with:  openssl rand -base64 48
# Must be at least 32 characters; the server refuses to start otherwise.
JWT_SECRET=
JWT_EXPIRES_IN=365d

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- AI providers (optional) -----------------------------------------------
# With neither set, reflections and insights use built-in fallback text.
GROQ_API_KEY=
OPENAI_API_KEY=
